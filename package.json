{
  "name": "relay",
  "version": "3.0.0",
  "description": "A lightweight server that bridges remote clients to local AI coding agents via WebSockets",
  "bin": {
    "relay": "dist/cli/bin.js"
  },
  "files": [
    "dist/",
    "app/dist/"
  ],
  "type": "module",
  "main": "dist/server/core/index.js",
  "types": "dist/server/core/index.d.ts",
  "imports": {
    "#core/*.js": {
      "relay-dev": "./server/core/*.ts",
      "default": "./dist/server/core/*.js"
    },
    "#server/*.js": {
      "relay-dev": "./server/*.ts",
      "default": "./dist/server/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/server/core/index.d.ts",
      "import": "./dist/server/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:app",
    "build:server": "tsc",
    "build:app": "pnpm --filter relay-app build",
    "start": "node dist/cli/bin.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js && pnpm --filter relay-app test",
    "typecheck": "tsc --noEmit && pnpm --filter relay-app typecheck",
    "typecheck:app": "pnpm --filter relay-app typecheck",
    "fmt": "oxfmt server/ cli/ app/src/",
    "fmt:check": "oxfmt --check server/ cli/ app/src/",
    "lint": "oxlint server/ cli/ app/src/",
    "lint:fix": "oxlint --fix server/ cli/ app/src/",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@chenglou/pretext": "^0.0.2",
    "@hono/node-server": "^1.19.4",
    "better-sqlite3": "^12.6.2",
    "cookie": "^0.6.0",
    "hono": "^4.10.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "husky": "^9.1.7",
    "knip": "^6.0.3",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt",
      "oxlint"
    ],
    "*.{json,md,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.22.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ]
  }
}
