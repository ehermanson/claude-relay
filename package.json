{
  "name": "claude-relay",
  "version": "2.0.0",
  "description": "A lightweight server that bridges remote clients to a local Claude Code CLI via WebSockets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "claude-relay": "dist/bin.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "tsc --watch & node --watch dist/bin.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cookie": "^0.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
